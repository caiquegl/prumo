# Cole estes valores em Vercel → Project → Settings → Environment Variables (Production).
# Nenhum deles deve ir para o git.

# Connection string do Neon (projeto "prumo"). Tokens, logs e publicações ficam aqui.
DATABASE_URL=

# Instagram professional account id (já conhecido da @prumo.web)
IG_USER_ID=17841427877735853

# App Meta (developers.facebook.com/apps → Configurações → Básico)
META_APP_ID=
META_APP_SECRET=

# Opcional: bootstrap se o banco ainda não tiver token. Depois do POST /api/ig/token
# o token da Página e o de usuário de 60 dias ficam no Neon e o cron renova sozinho.
META_PAGE_TOKEN=

# Segredo aleatório. A Vercel envia Authorization: Bearer <CRON_SECRET> nos crons.
# Também vale para disparo manual: /api/cron/instagram?secret=...
CRON_SECRET=

# Unsplash (developers.unsplash.com) — fotos reais nos layouts hero/split.
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=
UNSPLASH_APP_ID=

# Google AI Studio (nível gratuito) — copy + Imagén fallback.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Pollinations (enter.pollinations.ai/keys) — nanobanana/flux na cascata.
POLLINATIONS_API_KEY=

# Hugging Face (huggingface.co/settings/tokens) — FLUX.1-schnell fallback.
HF_TOKEN=

# Ideogram (developer.ideogram.ai) — melhor design/visual; prioridade na cascata se presente.
# Tipografia do post NÃO depende disso (marca/@/WhatsApp são renderizados no FeedCard).
IDEOGRAM_API_KEY=

# Leonardo AI (app.leonardo.ai → API Access) — último fallback.
LEONARDO_API_KEY=
LEONARDO_MODEL_ID=aa77f04e-3eec-4034-9c07-d0f619884a84

# --- APIs opcionais para evoluir o fluxo (ainda não ligadas no código) ---
# Bannerbear / Placid / Creatomate: tipografia 100% fiel via templates dinâmicos
#   https://bannerbear.com  https://placid.app  https://creatomate.com
# Recraft API: ilustração/SVG com paleta de marca
#   https://www.recraft.ai
